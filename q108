#include <stdio.h>
void productExceptSelf(int nums[], int n, int answer[]) {
    int left_product = 1;
    for (int i = 0; i < n; i++) {
        answer[i] = left_product;
        left_product *= nums[i];
    }
    int right_product = 1;
    for (int i = n - 1; i >= 0; i--) {
        answer[i] *= right_product;
        right_product *= nums[i];
    }
}
int main() {
    int nums[] = {1, 2, 3, 4};
    int n = sizeof(nums) / sizeof(nums[0]);
    int answer[n];
    productExceptSelf(nums, n, answer);
    printf("Answer array: [ ");
    for (int i = 0; i < n; i++) {
        printf("%d ", answer[i]);
    }
    printf("]\n");
    return 0;
}
